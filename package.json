{
  "name": "cms-system",
  "version": "1.0.0",
  "description": "A modern Content Management System with Vue.js frontend and Node.js backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node ./node_modules/nodemon/bin/nodemon.js server/index.js",
    "dev": "node scripts/dev.js",
    "server": "node ./node_modules/nodemon/bin/nodemon.js server/index.js --watch server",
    "client": "npm --prefix client run serve",
    "build": "npm --prefix client run build",
    "db:migrate": "node server/migrations/fix-current-schema.js",
    "db:seed": "node server/migrations/seed-demo-data.js",
    "db:reset-academic": "node server/migrations/reset-academic-demo-data.js",
    "install-all": "npm install; npm install --prefix client",
    "start:prod": "node server/index.js"
  },
  "keywords": [
    "cms",
    "content-management",
    "vue",
    "nodejs",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.0.0",
    "ical-generator": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "resend": "^6.12.3",
    "semver": "^7.7.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.1.14"
  }
}
