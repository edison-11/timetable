{
  "name": "cms-system",
  "version": "1.0.0",
  "description": "A modern Content Management System with Vue.js frontend and Node.js backend",
  "main": "server/index.js",
  "scripts": {
    "start": "nodemon server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js --watch server",
    "client": "cd client && npm run serve",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "start:prod": "node server/index.js"
  },
  "keywords": [
    "cms",
    "content-management",
    "vue",
    "nodejs",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  }
}
